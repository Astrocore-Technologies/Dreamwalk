# Copy once to the ignored root .env; edit existing assignments instead of appending duplicates.
# Never commit real credentials. This template does not enable paid generation.
# For an existing game, keep its database and assets; do not create a new ledger to reset spend.
# Configure either the existing DATABASE_URL or DREAMWALK_DATABASE_ENV_FILE below.
# DATABASE_URL=<existing PostgreSQL connection string; keep credentials private>
# DREAMWALK_DATABASE_ENV_FILE=/absolute/path/to/existing/database.env
# The database file must contain ONLY DATABASE_URL.
# npm run db:local creates a cluster if missing. Start it only in the checkout holding the intended cluster.
NODE_ENV=development
API_PORT=4000
# Production containers: API_HOST=0.0.0.0; omit API_PORT to use platform PORT.
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# If selecting another web port, keep PORT/--port and WEB_ORIGIN consistent.
# PORT=3000
ASSET_DIR=.local/assets
# For an existing game, replace ASSET_DIR with its existing asset directory.

# Server-only key. Fill this in the ignored root .env, never apps/web or NEXT_PUBLIC_*.
# One OPENAI_API_KEY serves text and images. Leave it empty in this public template.
OPENAI_API_KEY=
# Alternative: REMOVE the OPENAI_API_KEY assignment above before using NPC_AI_API_KEY.
# Do not define both, even with one empty: text and images have different precedence.
# NPC_AI_API_KEY=
# Optional private server file instead of a root key; use an absolute path.
# In owner mode its allowed settings override root .env; see docs/owner-generation.md.
# DREAMWALK_SERVER_ENV_FILE=/absolute/private/path/server.env

# Keep these platform flags unchanged; owner generation is a separate budgeted subsystem.
AI_PROVIDER=mock
# Legacy model placeholders below do not select owner models; use the JSON profile.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
PAID_GENERATION_ENABLED=false
PAYMENTS_ENABLED=false
DISCORD_ENABLED=false
DEV_AUTH_ENABLED=false
DEMO_FAUCET_ENABLED=false
GLOBAL_SPEND_CAP=0

# Normal owner mode, NOT an expiring manual-test session. Disabled until deliberately configured.
# Ordinary open-alpha mode uses GENERATION_MODE=release and GENERATION_CONFIG_JSON.
# See docs/release-generation.md: strict reviewed profile + explicit aggregateCapMicros.
# No provider calls or wallet funding are enabled by this example.
GENERATION_MODE=disabled
LIVE_TEST_ENABLED=false
NPC_AI_KILL_SWITCH=false
# GENERATION_OWNER_HANDLE=your_registered_handle
# Use the existing persistent database and registered account; do not replace them.
# Review and acknowledge the displayed policy in the owner panel before any manual paid request.

# JSON WORKSHEET: valid multiline dotenv/JSON, intentionally NOT an enabled owner profile.
# Replace every angle-bracket string and REPLACE_WITH_REVIEWED_MODEL; numeric fields require integers.
# No model, tariff, date, budget permission or image-risk acceptance is provided by this template.
# 1 USD = 1000000 micro-units. Purpose caps share the total; they are not extra allowances.
# contextTokens = model capacity; contextBudgetTokens = chosen total input + reply window PER REQUEST.
# 256000 is only an example, not a product maximum or a session quota; maxOutputTokens is separate.
# Do not add legacy maxInputBytes=64000 to this window mode; the server derives a 4 MiB transport guard.
# Ordinary offline token accounting is labelled conservative and may pack less than the real tokenizer.
# Leave text.counting ABSENT unless the separate manual counting fee is reviewed.
# Release gpt-6-luna with contextBudgetTokens + estimation defaults to runtime map vision.
# Explicit gameplay quote POSTs count its exact image-aware body; no image allowance is guessed.
# Its unknown operational count fee is recorded as NULL, not billed to player Sparks/Dreams.
# Set text.runtimeVision=false to opt out; other models/modes do not gain this default.
# See docs/runtime-map-vision.md. This template does not deploy or authorize a live test.
# Estimation margins/reference allowances are reviewed operator assumptions, not provider invoice limits.
# maxReferenceImages accepts 0/1/2; zero disables photo and approved-concept reference workflows.
# Set image.estimateRiskAccepted=true only after reviewing estimate uncertainty; it defaults to false.
# Pricing dates describe evidence validity, not a new spending grant. Never renew them without review.
# Later profile changes require a reviewed policy revision; spent/held/unknown costs and stops persist.
# Use single quotes around the complete JSON; do not paste another assignment below an existing one.
GENERATION_OWNER_CONFIG_JSON='{
  "totalCapMicros": "<combined cumulative USD micro-unit ceiling>",
  "textCapMicros": "<text purpose ceiling within the combined ceiling>",
  "imageCapMicros": "<image purpose ceiling within the combined ceiling>",
  "text": {
    "model": "<verified supported Responses model>",
    "contextTokens": "<verified model context capacity>",
    "contextBudgetTokens": 256000,
    "maxOutputTokens": 2048,
    "inputMicrosPerMillion": "<reviewed input USD micro-units per million tokens>",
    "outputMicrosPerMillion": "<reviewed output USD micro-units per million tokens>",
    "estimation": {
      "kind": "operator_heuristic",
      "textTokensPerKiBUtf8": "<reviewed planning tokens per 1024 serialized UTF-8 bytes>",
      "textProtocolTokens": "<reviewed protocol token allowance>",
      "marginBps": "<reviewed percentage margin: 10000 = 100 percent>",
      "fixedMarginMicros": "<reviewed additional fixed request reserve in USD micro-units>"
    },
    "pricing": {
      "source": "https://developers.openai.com/api/docs/models/REPLACE_WITH_REVIEWED_MODEL",
      "reviewedAt": "<actual review time as a UTC ISO timestamp>",
      "validUntil": "<chosen pricing-review expiry as a UTC ISO timestamp>"
    }
  },
  "image": {
    "model": "<verified supported Images model with reference/edit support>",
    "size": "1024x1024",
    "quality": "low",
    "outputs": 1,
    "format": "png",
    "maxPromptUtf8Bytes": 8000,
    "maxReferenceImages": 2,
    "inputTextMicrosPerMillion": "<reviewed text-input rate in USD micro-units per million tokens>",
    "inputImageMicrosPerMillion": "<reviewed image-input rate in USD micro-units per million tokens>",
    "outputImageMicrosPerMillion": "<reviewed image-output rate in USD micro-units per million tokens>",
    "estimation": {
      "kind": "operator_heuristic",
      "textTokensPerKiBUtf8": "<reviewed planning tokens per 1024 serialized UTF-8 bytes>",
      "textProtocolTokens": "<reviewed protocol token allowance>",
      "marginBps": "<reviewed percentage margin: 10000 = 100 percent>",
      "fixedMarginMicros": "<reviewed additional fixed request reserve in USD micro-units>",
      "outputImageTokens": "<reviewed output-token assumption for this exact model, size and quality>",
      "referenceImageTokensPerImage": "<reviewed operator input-token allowance per reference>",
      "referenceAllowanceMicros": "<reviewed extra uncertainty reserve per reference in USD micro-units>"
    },
    "estimateRiskAccepted": false,
    "pricing": {
      "source": "https://developers.openai.com/api/docs/models/REPLACE_WITH_REVIEWED_MODEL",
      "reviewedAt": "<actual review time as a UTC ISO timestamp>",
      "validUntil": "<chosen pricing-review expiry as a UTC ISO timestamp>"
    }
  }
}'
# Server-side credentials only. No NEXT_PUBLIC_ keys or tokens.
# Optional server-side SMTP. Leave ALL unset for honest disabled email delivery.
# Configure only after owner authorizes the chosen mail service; local tests use loopback capture.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=no-reply@example.invalid
# SMTP_USER=server-only-user
# SMTP_PASSWORD=server-only-password
# Production always requires STARTTLS (or implicit TLS) and valid TLS1.2+ certificates.
