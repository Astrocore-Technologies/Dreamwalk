# Copy to .env only when connecting your own PostgreSQL. Never commit credentials.
# npm run db:local generates .local/preview-live/database.env automatically for isolated local development.
# DATABASE_URL=postgresql://dreamwalk:YOUR_UNIQUE_PASSWORD@127.0.0.1:55432/dreamwalk
NODE_ENV=development
API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
AI_PROVIDER=mock
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
PAID_GENERATION_ENABLED=false
PAYMENTS_ENABLED=false
DISCORD_ENABLED=false
DEV_AUTH_ENABLED=false
DEMO_FAUCET_ENABLED=false
GLOBAL_SPEND_CAP=0
ASSET_DIR=.local/assets
# Optional owner-operated generation. Disabled unless explicitly configured.
GENERATION_MODE=disabled
# One-time server setup: see docs/owner-generation.md. No temporary session file.
# GENERATION_OWNER_HANDLE=your_registered_handle
# GENERATION_OWNER_CONFIG_JSON='<explicit validated model/pricing/budget profile>'
# Text window: contextTokens=model capacity; contextBudgetTokens=chosen per-request window within model capacity; maxOutputTokens=separate reply reserve.
# Unsupported exact tokenizers use explicitly labelled conservative estimates; no count-API calls on startup.
# Prefer per-request estimation policies: actual serialized input/output plan plus margin.
# Image/reference planning assumptions are operator estimates, never provider invoice caps.
# Profile changes require a separate reviewed policy revision in the owner panel.
# Existing spend, reservations and permanent stops survive every revision.
# Prefer an existing private file outside the repository containing OPENAI_API_KEY.
# Its path must be absolute; only API receives the credential.
# DREAMWALK_SERVER_ENV_FILE=/absolute/private/path/server.env
# Or put OPENAI_API_KEY in this ignored root .env, never apps/web or NEXT_PUBLIC_*.
# Owner mode requires the existing persistent DATABASE_URL above, or an explicit
# file containing ONLY DATABASE_URL. It must not start a fresh ledger implicitly.
# DREAMWALK_DATABASE_ENV_FILE=/absolute/private/path/database.env
# Server-side credentials only. No NEXT_PUBLIC_ keys or tokens.
# Optional server-side SMTP. Leave ALL unset for honest disabled email delivery.
# Configure only after owner authorizes the chosen mail service; local tests use loopback capture.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=no-reply@example.invalid
# SMTP_USER=server-only-user
# SMTP_PASSWORD=server-only-password
# Production always requires STARTTLS (or implicit TLS) and valid TLS1.2+ certificates.
